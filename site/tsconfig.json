{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["esnext", "dom", "dom.iterable"],
		"types": ["vite-plus/client", "@types/node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"jsx": "preserve"
	},
	"include": ["src", "src/**/*.vue", "scripts", "test", "vite.config.ts", "env.d.ts", "cloudflare.config.ts"]
}
