{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "kind": "folder", "path": "Views", "target-membership": [ "Heart Beats" ] },
    { "kind": "folder", "path": "ViewModels", "target-membership": [ "Heart Beats" ] },
    { "kind": "folder", "path": "Extensions", "target-membership": [ "Heart Beats" ] },
    { "kind": "folder", "path": "Assets", "target-membership": [ "Heart Beats" ] },
    { "kind": "folder", "path": "Shared", "target-membership": [ "Heart Beats", "Heart Beats Widget" ] },
    { "kind": "folder", "path": "Widget", "target-membership": [ "Heart Beats Widget" ] },
    { "kind": "folder", "path": "MenuBar", "target-membership": [ "Heart Beats Menu Bar" ] },
    { "kind": "folder", "path": "Tests", "target-membership": [ "Heart Beats Tests" ] },
    { "kind": "folder", "path": "UITests", "target-membership": [ "Heart Beats UI Tests" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Heart Beats.app", "id": "249BF6A52AE3683C00A3E2F1", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/Heart Beats Tests.xctest", "id": "249BF6A52AE3683C00A3E2F2", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/Heart Beats UI Tests.xctest", "id": "249BF6A52AE3683C00A3E2F3", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/Heart Beats Widget.appex", "id": "24E1B69730943F4E0021C457", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Heart Beats/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/Heart Beats Menu Bar.bundle", "id": "24E1B69730943F4E0021C458", "type": "wrapper.cfbundle", "index": false, "target-membership": [ { "build-phase": "Heart Beats/copy/Embed Foundation Extensions", "platforms": [ "maccatalyst" ], "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "Heart Beats",
      "id": "249BF6A42AE3683C00A3E2F1",
      "product": "Products/Heart Beats.app",
      "product-type": "application",
      "dependencies": [
        "Heart Beats Widget",
        { "target": "Heart Beats Menu Bar", "platforms": [ "maccatalyst" ] },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS": "Assets/HeartBeats.entitlements",
        "DEVELOPMENT_ASSET_PATHS": "\"Assets/Preview Content\"",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SELECTED_FILES": "readonly",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.music",
        "INFOPLIST_KEY_NSAppleMusicUsageDescription": "Enables you to choose artists and genres from your library to play in Heart Beats.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UIStatusBarStyle": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationPortrait",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown",
        "PRODUCT_BUNDLE_IDENTIFIER": "is.ky.Heart-Beats",
      },
    },
    {
      "name": "Heart Beats Tests",
      "id": "249BF6A42AE3683C00A3E2F2",
      "product": "Products/Heart Beats Tests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "Heart Beats",
      "dependencies": [
        "Heart Beats",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "PRODUCT_BUNDLE_IDENTIFIER": "is.ky.Heart-Beats.Tests",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/Heart Beats.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/Heart Beats",
      },
    },
    {
      "name": "Heart Beats UI Tests",
      "id": "249BF6A42AE3683C00A3E2F3",
      "product": "Products/Heart Beats UI Tests.xctest",
      "product-type": "bundle.ui-testing",
      "dependencies": [
        "Heart Beats",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "PRODUCT_BUNDLE_IDENTIFIER": "is.ky.Heart-Beats.UITests",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_TARGET_NAME": "Heart Beats",
      },
    },
    {
      "name": "Heart Beats Widget",
      "id": "24E1B69630943F4E0021C457",
      "product": "Products/Heart Beats Widget.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS": "Config/Widget.entitlements",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "INFOPLIST_FILE": "Config/Widget-Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "is.ky.Heart-Beats.Widget",
        "SKIP_INSTALL": "YES",
      },
    },
    {
      "name": "Heart Beats Menu Bar",
      "id": "24E1B69630943F4E0021C458",
      "product": "Products/Heart Beats Menu Bar.bundle",
      "product-type": "bundle",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_NSPrincipalClass": "HBMenuBarPlugin",
        "MACOSX_DEPLOYMENT_TARGET": "27.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "is.ky.Heart-Beats.MenuBar",
        "SDKROOT": "macosx",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "macosx",
        "SUPPORTS_MACCATALYST": "NO",
        "WRAPPER_EXTENSION": "bundle",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
