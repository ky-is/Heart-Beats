# Copy to fastlane/.env (gitignored) and fill in. The same key as kanji-garden-ios/fastlane/.env works.
# App Store Connect API key: https://appstoreconnect.apple.com/access/integrations/api
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# Device for `fastlane device` (name or UDID from `xcrun devicectl list devices`); defaults to the first paired iPhone
# DEVICE=00008150-001A03003439401C
